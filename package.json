{
  "name": "porter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mcp": "tsc --build && node --env-file-if-exists=.env apps/mcp-server/dist/index.js",
    "submission:validate": "node --experimental-strip-types submission/validate.ts",
    "demo": "tsc --build && node apps/mcp-server/dist/demo.js",
    "square:smoke": "tsc --build && node --env-file-if-exists=.env apps/mcp-server/dist/square-smoke.js",
    "square:public": "tsc --build && node apps/mcp-server/dist/square-public-check.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}