# --- server -----------------------------------------------------------------
PORT=8080
# Public base URL. Must match the deployed origin exactly: it is the OAuth
# issuer and the RFC 9728 resource identifier, and Muse requires HTTPS.
PORTER_ISSUER=http://localhost:8080

# Signs slot ids and confirmation tokens. At least 32 characters.
# Changing it invalidates every outstanding slot id and confirmation token,
# so treat it as long-lived. Required in production or with PostgreSQL;
# generated only for an unconfigured local memory demo.
PORTER_SIGNING_SECRET=

# Legacy local demo keys. The salon pilot uses customer OAuth through Muse.
# Format for demo testing only: key:user_id, comma separated.
PORTER_API_KEYS=demo-key:user_demo

LOG_LEVEL=info

# --- demo mode --------------------------------------------------------------
# Mock adapter knobs for local demo testing; not the live salon pilot.
PORTER_DEMO_MODE=true
PORTER_MOCK_LATENCY_MS=0
PORTER_MOCK_FAILURE_RATE=0

# --- provider platforms -----------------------------------------------------
# Both stay OFF unless a token is set. Two gates before either may point at a
# real account: upstream rights clearance (Connector Terms 4.2), and
# re-recording the fixtures against a real sandbox.
# See apps/mcp-server/src/adapters.ts.
PORTER_SQUARE_ACCESS_TOKEN=
PORTER_SQUARE_BASE_URL=https://connect.squareupsandbox.com
PORTER_JOBBER_ACCESS_TOKEN=

# --- payments ---------------------------------------------------------------
# Test keys only. The server refuses to start with a live key unless
# PORTER_ALLOW_LIVE_STRIPE is explicitly true.
PORTER_STRIPE_SECRET_KEY=
PORTER_STRIPE_FEE_BPS=0
PORTER_ALLOW_LIVE_STRIPE=false

# --- rate limits ------------------------------------------------------------
# Two independent buckets. The per-adapter one protects Porter's standing with
# each platform: exceeding a published quota risks API access for every user.
PORTER_RATE_USER_BURST=60
PORTER_RATE_USER_PER_SEC=2
PORTER_RATE_ADAPTER_BURST=120
PORTER_RATE_ADAPTER_PER_SEC=10

# --- public-page reading ----------------------------------------------------
# Path to a JSON array of { key, url, categories, postalCode } sources.
# Off unless set. Read-only: it never submits a booking form. Writes and
# anything blocked by a CAPTCHA are handed to the user with a link.
#
# Leave this UNSET on a Muse-facing deployment. The Muse Connector Policies
# name "violating robots.txt" as a prohibited practice, and the submission has
# to describe what actually ships.
PORTER_WEB_SOURCES=

# Square public booking pages: a JSON array of { key, url, categories }.
# url is a book.squareup.com/appointments/<site>/location/<loc>/services page.
# Reads what the merchant already publishes, so no merchant account is needed.
# Experimental: can submit bookings when no card is required; protected flows
# hand the user a link. Not the approved pilot integration; leave unset there.
PORTER_SQUARE_PUBLIC_SOURCES=

# --- storage ---------------------------------------------------------------
# Empty DATABASE_URL keeps the local demo in memory. Setting DATABASE_URL
# selects PostgreSQL unless PORTER_STORAGE explicitly overrides it.
# Non-demo instances require postgres. Run `pnpm db:migrate` before starting.
# Local database from `pnpm db:up`:
# postgres://porter:porter@127.0.0.1:55432/porter
DATABASE_URL=
# Optional: memory | postgres. Memory is allowed only with mock writes;
# provider/payment credentials also require PostgreSQL when demo mode is on.
PORTER_STORAGE=
# Required with PostgreSQL. Generate with `openssl rand -hex 32` and keep stable.
# Wraps stored encryption keys; losing it makes encrypted data unreadable.
# Use a DIFFERENT value from PORTER_SIGNING_SECRET; keep both in your secret store.
PORTER_ENCRYPTION_KEY=

# --- self-serve salon pilot (separate from the demo) --------------------------
# Requires PostgreSQL, stable secrets, DEMO_MODE=false and empty API_KEYS.
# Do not combine with deployment-wide provider/payment/public-page adapters.
PORTER_PILOT_ENABLED=false
PORTER_SQUARE_ENVIRONMENT=sandbox
PORTER_SQUARE_APPLICATION_ID=
PORTER_SQUARE_APPLICATION_SECRET=
# Register <PORTER_ISSUER>/square/callback in this Square app's OAuth settings.
# File delivery is restricted to loopback sandbox development. Public hosting
# requires resend, a verified sender, and HTTPS. Outbox files contain private
# short-lived links; never publish, commit, or attach them.
PORTER_EMAIL_MODE=file
PORTER_EMAIL_OUTBOX=.porter/mail
PORTER_RESEND_API_KEY=
PORTER_EMAIL_FROM=
PORTER_PILOT_INVITED_EMAILS=
PORTER_OPERATOR_EMAILS=

# Customer setup uses the Muse store OAuth connection. Set this only after Meta
# provides the approved directory URL; never invent a connector URL.
PORTER_MUSE_CONNECTOR_URL=
# Optional internal test credential endpoints, local sandbox only.
# Never enable as the product's customer connection flow.
PORTER_INTERNAL_API_KEYS=false
