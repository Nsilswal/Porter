# --- server -----------------------------------------------------------------
PORT=8080
# Public base URL. Must match the deployed origin exactly: it is the OAuth
# issuer and the RFC 9728 resource identifier, and Muse requires HTTPS.
PORTER_ISSUER=http://localhost:8080

# Signs slot ids and confirmation tokens. At least 32 characters.
# Changing it invalidates every outstanding slot id and confirmation token,
# so treat it as long-lived. Required in production; generated in dev.
PORTER_SIGNING_SECRET=

# Static keys for Muse's custom-connector flow, which is built around API keys
# rather than OAuth. Format: key:user_id, comma separated.
PORTER_API_KEYS=demo-key:user_demo

LOG_LEVEL=info

# --- demo mode --------------------------------------------------------------
# Mock adapter knobs, used for demos and for Meta's end-to-end review.
PORTER_DEMO_MODE=true
PORTER_MOCK_LATENCY_MS=0
PORTER_MOCK_FAILURE_RATE=0

# --- provider platforms -----------------------------------------------------
# Both stay OFF unless a token is set. Two gates before either may point at a
# real account: upstream rights clearance (Connector Terms 4.2), and
# re-recording the fixtures against a real sandbox.
# See apps/mcp-server/src/adapters.ts.
PORTER_SQUARE_ACCESS_TOKEN=
PORTER_SQUARE_BASE_URL=https://connect.squareupsandbox.com
PORTER_JOBBER_ACCESS_TOKEN=

# --- payments ---------------------------------------------------------------
# Test keys only. The server refuses to start with a live key unless
# PORTER_ALLOW_LIVE_STRIPE is explicitly true.
PORTER_STRIPE_SECRET_KEY=
PORTER_STRIPE_FEE_BPS=0
PORTER_ALLOW_LIVE_STRIPE=false

# --- rate limits ------------------------------------------------------------
# Two independent buckets. The per-adapter one protects Porter's standing with
# each platform: exceeding a published quota risks API access for every user.
PORTER_RATE_USER_BURST=60
PORTER_RATE_USER_PER_SEC=2
PORTER_RATE_ADAPTER_BURST=120
PORTER_RATE_ADAPTER_PER_SEC=10

# --- public-page reading ----------------------------------------------------
# Path to a JSON array of { key, url, categories, postalCode } sources.
# Off unless set. Read-only: it never submits a booking form. Writes and
# anything blocked by a CAPTCHA are handed to the user with a link.
#
# Leave this UNSET on a Muse-facing deployment. The Muse Connector Policies
# name "violating robots.txt" as a prohibited practice, and the submission has
# to describe what actually ships.
PORTER_WEB_SOURCES=

# --- database (milestone 5+) ------------------------------------------------
# Railway Postgres. Milestone 2 runs on the in-memory store and does not need it.
DATABASE_URL=postgres://porter:porter@localhost:5432/porter
REDIS_URL=redis://localhost:6379
